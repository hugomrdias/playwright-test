{
  "name": "playwright-test",
  "type": "module",
  "version": "15.0.1",
  "description": "Run mocha, node:test and taps scripts inside real browsers with playwright.",
  "author": "Hugo Dias <hugomrdias@gmail.com> (hugodias.me)",
  "license": "MIT",
  "repository": "hugomrdias/playwright-test",
  "keywords": [
    "playwright",
    "test",
    "tests",
    "test-runner",
    "mocha",
    "coverage",
    "istanbul",
    "nyc",
    "code coverage"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/runner.d.ts",
      "default": "./src/runner.js"
    },
    "./package.json": "./package.json",
    "./taps": {
      "types": "./dist/src/taps/index.d.ts",
      "default": "./src/taps/index.js"
    },
    "./node-test": {
      "types": "./dist/src/node/test.d.ts",
      "default": "./src/node/test.js"
    },
    "./node-assert": {
      "types": "./dist/src/node/assert.d.ts",
      "default": "./src/node/assert.js"
    },
    "./node-util": {
      "types": "./dist/src/node/util.d.ts",
      "default": "./src/node/util.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "default": "./src/client/index.js"
    }
  },
  "main": "src/runner.js",
  "types": "dist/src/runner.d.ts",
  "typesVersions": {
    "*": {
      "taps": [
        "dist/src/taps/index.d.ts"
      ],
      "node-test": [
        "dist/src/node/test.d.ts"
      ],
      "node-assert": [
        "dist/src/node/assert.d.ts"
      ],
      "node-util": [
        "dist/src/node/util.d.ts"
      ],
      "client": [
        "dist/src/client/index.d.ts"
      ]
    }
  },
  "bin": {
    "playwright-test": "cli.js",
    "pw-test": "cli.js"
  },
  "files": [
    "dist/src/runner.d.ts",
    "dist/src/runner.d.ts.map",
    "dist/src/node",
    "dist/src/types.d.ts",
    "dist/src/taps",
    "dist/src/client",
    "static",
    "src",
    "cli.js"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.7.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf .coverage .nyc_output dist node_modules .tmp",
    "fix": "biome check --fix .",
    "lint": "tsc --noEmit && biome check .",
    "test": "node --test --test-force-exit --test-timeout=50000 --test-concurrency=4 \"tests/*.test.js\""
  },
  "dependencies": {
    "acorn-loose": "^8.5.2",
    "buffer": "^6.0.3",
    "c8": "^12.0.0",
    "chokidar": "^6.0.0",
    "esbuild": "0.28.2",
    "esbuild-plugin-wasm": "^1.1.0",
    "exit-hook": "^5.1.0",
    "kleur": "^4.1.5",
    "lilconfig": "^3.1.4",
    "merge-options": "^3.0.4",
    "nanoid": "^6.0.2",
    "ora": "^10.0.0",
    "p-timeout": "^8.0.0",
    "path-browserify": "^1.0.1",
    "playwright-core": "1.65.0",
    "polka": "^0.5.2",
    "premove": "^4.0.0",
    "sade": "^1.8.1",
    "sirv": "^3.0.2",
    "source-map": "0.6.1",
    "tempy": "^3.2.0",
    "test-exclude": "^8.0.0",
    "tinyglobby": "^0.2.17",
    "v8-to-istanbul": "^9.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@hugomrdias/configs": "^2.0.0",
    "@types/polka": "^0.5.8",
    "debug": "^4.4.3",
    "delay": "^7.0.0",
    "execa": "^10.2.1",
    "mocha": "^12.0.3",
    "p-defer": "^4.0.1",
    "simple-git-hooks": "^2.14.0",
    "tinybench": "^6.2.3",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --no-errors-on-unmatched --files-ignore-unknown=true --staged"
  }
}
