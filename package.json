{
  "name": "playwright-test",
  "type": "module",
  "version": "15.0.1",
  "description": "Run mocha and node:test scripts inside real browsers with playwright.",
  "author": "Hugo Dias <hugomrdias@gmail.com> (hugodias.me)",
  "license": "MIT",
  "repository": "hugomrdias/playwright-test",
  "keywords": [
    "playwright",
    "test",
    "tests",
    "test-runner",
    "mocha"
  ],
  "exports": {
    ".": "./src/runner.ts",
    "./package.json": "./package.json",
    "./node-test": "./src/node/test.ts",
    "./node-assert": "./src/node/assert.ts",
    "./node-util": "./src/node/util.ts",
    "./client": "./src/client/index.ts"
  },
  "bin": {
    "playwright-test": "./src/bin.ts",
    "pw-test": "./src/bin.ts"
  },
  "publishConfig": {
    "main": "./dist/runner.js",
    "types": "./dist/runner.d.ts",
    "bin": {
      "playwright-test": "./dist/bin.js",
      "pw-test": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/runner.d.ts",
        "default": "./dist/runner.js"
      },
      "./package.json": "./package.json",
      "./node-test": {
        "types": "./dist/node/test.d.ts",
        "default": "./dist/node/test.js"
      },
      "./node-assert": {
        "types": "./dist/node/assert.d.ts",
        "default": "./dist/node/assert.js"
      },
      "./node-util": {
        "types": "./dist/node/util.d.ts",
        "default": "./dist/node/util.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      }
    },
    "typesVersions": {
      "*": {
        "node-test": [
          "dist/node/test.d.ts"
        ],
        "node-assert": [
          "dist/node/assert.d.ts"
        ],
        "node-util": [
          "dist/node/util.d.ts"
        ],
        "client": [
          "dist/client/index.d.ts"
        ]
      }
    }
  },
  "files": [
    "dist",
    "src",
    "static"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node scripts/prepack.ts && pnpm run build",
    "clean": "rm -rf dist node_modules",
    "fix": "biome check --fix .",
    "lint": "tsc && biome check .",
    "test": "node --test --test-force-exit --test-timeout=50000 --test-concurrency=3 \"tests/*.test.ts\""
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "acorn-loose": "^8.5.2",
    "chokidar": "^6.0.0",
    "esbuild": "0.28.2",
    "esbuild-plugin-wasm": "^1.1.0",
    "exit-hook": "^5.1.0",
    "lilconfig": "^3.1.4",
    "path-browserify": "^1.0.1",
    "playwright-core": "1.65.0",
    "sade": "^1.8.1",
    "std-env": "^4.3.0",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "cf": "^1.0.0-rc.1"
  },
  "peerDependenciesMeta": {
    "cf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@hugomrdias/configs": "^2.0.0",
    "cf": "1.0.0-rc.1",
    "debug": "^4.4.3",
    "delay": "^7.0.0",
    "execa": "^10.2.1",
    "mocha": "^12.0.3",
    "p-defer": "^4.0.1",
    "pkg-pr-new": "^0.0.94",
    "simple-git-hooks": "^2.14.0",
    "tinybench": "^6.2.3",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec biome check --no-errors-on-unmatched --files-ignore-unknown=true --staged"
  }
}
