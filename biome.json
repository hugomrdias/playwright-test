{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["@hugomrdias/configs/biome"],
  "files": {
    "includes": [
      "!src/vendor/*.js",
      "!.github/ISSUE_TEMPLATE/*.md",
      "!mocks/commonjs/*.js"
    ]
  },
  "overrides": [
    {
      "includes": ["mocks/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noIdenticalTestTitle": "off"
          }
        }
      }
    }
  ]
}
